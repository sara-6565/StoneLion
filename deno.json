{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns", "deno.unstable"],
    "types": ["deno.ns"]
  },
  "fmt": {
    "lineWidth": 80
  },
  "importMap": "import_map.json",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --unstable-kv --import-map=import_map.json server.ts"
  },
  "deploy": {
    "org": "sara-6565",
    "app": "stonelion",
    "exclude": [".git", ".gitignore", "README.md"]
  }
}

